---
import PlanetLayout from "@layouts/PlanetLayout.astro";
import planets from "@data/planets.json";
import PlanetTabs from "@components/PlanetTabs.astro";
export async function getStaticPaths() {
  return planets.map((planet) => {
    return {
      params: { planet: planet.name.toLowerCase() },
      props: { planet },
    };
  });
}

const { planet } = Astro.props;
---

<PlanetLayout pageTitle={planet.name}>
  <PlanetTabs planet={planet} />
  <section class="stats">
    <h2 class="sr-only">Planet Statistics</h2>
    <ul class="stats-list">
      <li class="stats-list__item">
        <p class="stats__key">Rotation Time</p>
        <p class="stats__value">{planet.rotation}</p>
      </li>
      <li class="stats-list__item">
        <p class="stats__key">Revolution Time</p>
        <p class="stats__value">{planet.revolution}</p>
      </li>
      <li class="stats-list__item">
        <p class="stats__key">Radius</p>
        <p class="stats__value">{planet.radius}</p>
      </li>
      <li class="stats-list__item">
        <p class="stats__key">Average Temp.</p>
        <p class="stats__value">{planet.temperature}</p>
      </li>
    </ul>
  </section>
</PlanetLayout>

<style>
  .stats {
    padding: var(--page-padding);
  }
  .stats-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .stats-list__item {
    align-items: center;
    border: 1px solid rgb(from var(--color-border) r g b / 0.2);
    display: flex;
    justify-content: space-between;
    padding: 0.75rem 1.5rem;
  }

  .stats__key {
    font-size: clamp(0.75rem, 0.662rem + 0.3756vw, 1rem);
    letter-spacing: 0.75px;
    line-height: 2;
    opacity: 0.5;
    text-transform: uppercase;
  }

  .stats__value {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 0.8099rem + 1.8779vw, 2.5rem);
    letter-spacing: clamp(-0.0937rem, -0.0304rem + -0.0704vw, -0.0469rem);
    line-height: 1.3;
    text-align: right;
    text-transform: uppercase;
  }

  @media (min-width: 768px) {
    .stats {
      display: flex;
    }
    .stats-list {
      flex: 1;
      flex-direction: row;
    }

    .stats-list__item {
      align-items: flex-start;
      flex: 1;
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
