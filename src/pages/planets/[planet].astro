---
import PlanetLayout from "@layouts/PlanetLayout.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import planets from "@data/planets.json";

export async function getStaticPaths() {
  return planets.map((planet) => {
    return {
      params: { planet: planet.name.toLowerCase() },
      props: { planet },
    };
  });
}

const { planet } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/*.{jpeg,jpg,png,gif,webp,svg}",
);
const getImagePath = (jsonPath: string) => {
  const filename = jsonPath.split("/").pop();
  return `/src/assets/images/${filename}`;
};
const geologyImageSrc = images[getImagePath(planet.images.geology)];

if (!geologyImageSrc)
  throw new Error(
    `Could not find planet image at ${getImagePath(planet.images.geology)}`,
  );
---

<PlanetLayout pageTitle={planet.name}>
  <div class="planet__tabs">
    <ul class="tabs-list">
      <li class="tabs-list__item">
        <span class="tab-number">01</span><p class="tab-text">Overview</p>
      </li>
      <li class="tabs-list__item">
        <span class="tab-number">02</span><p class="tab-text">
          Internal Structure
        </p>
      </li>
      <li class="tabs-list__item">
        <span class="tab-number">03</span><p class="tab-text">
          Surface Geology
        </p>
      </li>
    </ul>
  </div>
  <div class="planet__image">
    <div class="overview">
      <Icon
        name={`planet-${planet.name.toLowerCase()}`}
        aria-hidden="true"
      />
    </div>
    <div class="structure">
      <Icon
        name={`planet-${planet.name.toLowerCase()}-internal`}
        aria-hidden="true"
      />
    </div>
    <div class="geology">
      <Icon
        name={`planet-${planet.name.toLowerCase()}`}
        aria-hidden="true"
      />
      <Image
        src={geologyImageSrc()}
        alt=""
        aria-hidden="true"
        class="planet__geology"
      />
    </div>
  </div>
  <section class="details">
    <h1>{planet.name}</h1>
    <div class="overview">
      <p>{planet.overview.content}</p>
      <p>
        Source: <a href={planet.overview.source}>
          Wikipedia
          <Icon
            name="icon-source"
            aria-hidden="true"
          />
        </a>
      </p>
    </div>

    <div class="structure">
      <p>{planet.structure.content}</p>
      <p>
        Source: <a href={planet.structure.source}>
          Wikipedia
          <Icon
            name="icon-source"
            aria-hidden="true"
          />
        </a>
      </p>
    </div>

    <div class="geology">
      <p>{planet.geology.content}</p>
      <p>
        Source: <a href={planet.geology.source}>
          Wikipedia
          <Icon
            name="icon-source"
            aria-hidden="true"
          />
        </a>
      </p>
    </div>
  </section>
  <section class="stats">
    <h2 class="sr-only">Planet Statistics</h2>
    <ul class="stats-list">
      <li class="stats-list__item">
        <h3>Rotation Time</h3>
        <p class="stats--data">{planet.rotation}</p>
      </li>
      <li class="stats-list__item">
        <h3>Revolution Time</h3>
        <p class="stats--data">{planet.revolution}</p>
      </li>
      <li class="stats-list__item">
        <h3>Radius</h3>
        <p class="stats--data">{planet.radius}</p>
      </li>
      <li class="stats-list__item">
        <h3>Average Temp.</h3>
        <p class="stats--data">{planet.temperature}</p>
      </li>
    </ul>
  </section>
</PlanetLayout>

<style>
  .planet__image {
    display: grid;
    place-content: center;
    [data-icon] {
      height: clamp(6.9375rem, 2.9982rem + 16.8075vw, 18.125rem);
      width: auto;
    }

    .geology {
      position: relative;

      img {
        height: clamp(6.25rem, 4.0713rem + 9.2958vw, 12.4375rem);
        position: absolute;
        top: 75%;
        left: 50%;
        transform: translate(-50%, 0%);
        width: auto;
      }
    }
  }
</style>
