---
import PlanetLayout from "@layouts/PlanetLayout.astro";
export function getStaticPaths() {
  return [
    { params: { planet: "mercury" } },
    { params: { planet: "venus" } },
    { params: { planet: "earth" } },
    { params: { planet: "mars" } },
    { params: { planet: "jupiter" } },
    { params: { planet: "saturn" } },
    { params: { planet: "uranus" } },
    { params: { planet: "neptune" } },
  ];
}

const { planet } = Astro.params;
---

<PlanetLayout pageTitle={planet}>
  <h1>{planet}</h1>
</PlanetLayout>
