---
import PlanetLayout from "@layouts/PlanetLayout.astro";
import planets from "@data/planets.json";
import PlanetTabs from "@components/PlanetTabs.astro";
export async function getStaticPaths() {
  return planets.map((planet) => {
    return {
      params: { planet: planet.name.toLowerCase() },
      props: { planet },
    };
  });
}

const { planet } = Astro.props;
---

<PlanetLayout pageTitle={planet.name}>
  <PlanetTabs planet={planet} />
  <section class="stats">
    <h2 class="sr-only">Planet Statistics</h2>
    <ul class="stats-list">
      <li class="stats-list__item">
        <h3>Rotation Time</h3>
        <p class="stats--data">{planet.rotation}</p>
      </li>
      <li class="stats-list__item">
        <h3>Revolution Time</h3>
        <p class="stats--data">{planet.revolution}</p>
      </li>
      <li class="stats-list__item">
        <h3>Radius</h3>
        <p class="stats--data">{planet.radius}</p>
      </li>
      <li class="stats-list__item">
        <h3>Average Temp.</h3>
        <p class="stats--data">{planet.temperature}</p>
      </li>
    </ul>
  </section>
</PlanetLayout>
