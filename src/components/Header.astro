---
import navData from "@data/navData.json";
import NavToggle from "./NavToggle.astro";
---

<header>
  <div class="logo">
    <a href="/">The Planets</a>
  </div>
  <nav
    id="main-menu"
    aria-label="Main navigation"
  >
    <ul class="nav__list">
      {
        navData.map((navItem) => (
          <li class="nav__item">
            <a href={navItem.url}>{navItem.key}</a>
          </li>
        ))
      }
    </ul>
  </nav>
  <NavToggle />
</header>

<style>
  header {
    align-items: stretch;
    background-color: transparent;
    border-bottom: 1px solid rgb(from var(--color-border) r g b / 0.2);
    display: flex;
    justify-content: space-between;
    padding-bottom: clamp(1rem, 0.8239rem + 0.7512vw, 1.5rem);
  }

  .logo {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    letter-spacing: -1px;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .nav__item {
    text-transform: uppercase;
  }

  @media (max-width: 767px) {
    .nav__item {
      padding-block: 1.25rem;
      border-bottom: 1px solid rgb(from var(--color-border) r g b / 0.1);
      &:last-child {
        border-bottom: none;
      }
    }
  }

  @media (min-width: 768px) {
    header {
      align-items: center;
      flex-direction: column;
      gap: clamp(0rem, 4.2857rem + -4.7619vw, 2rem);
      margin-top: clamp(0rem, 4.2857rem + -4.7619vw, 2rem);
    }

    nav,
    .nav__list {
      align-items: stretch;
      display: flex;
      flex-direction: row;
      gap: clamp(2rem, 1.4286rem + 1.1905vw, 2.5rem);
    }

    .nav__item {
      align-items: center;
      border-top: 4px solid transparent;
      display: flex;
      transition: border-color 0.3s;
    }

    .nav__item:hover {
      border-color: var(--color-accent);
    }
  }

  @media (min-width: 1024px) {
    header {
      flex-direction: row;
      padding-block: 1.5rem;
      padding-inline: 2rem;
    }
  }
</style>
