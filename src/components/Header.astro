---
import navData from "@data/navData.json";
import NavToggle from "./NavToggle.astro";
import { Icon } from "astro-icon/components";
---

<header>
  <div class="logo">
    <a href="/">The Planets</a>
  </div>
  <nav
    id="main-menu"
    aria-label="Main navigation"
  >
    <ul class="nav__list">
      {
        navData.map((navItem) => (
          <li class={`nav__item color-${navItem.key.toLowerCase()}`}>
            <a href={navItem.url}>
              <div class="color-circle" />
              {navItem.key}
              <Icon name="icon-chevron" />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <NavToggle />
</header>

<style>
  header {
    align-items: stretch;
    background-color: transparent;
    border-bottom: 1px solid rgb(from var(--color-border) r g b / 0.2);
    display: flex;
    justify-content: space-between;
    padding-bottom: clamp(1rem, 0.8239rem + 0.7512vw, 1.5rem);
    position: relative;
  }

  .logo {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    letter-spacing: -1px;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .nav__item {
    text-transform: uppercase;
    [data-icon] {
      height: 0;
      width: 0;
    }
  }

  @media (max-width: 767px) {
    header {
      padding: 1rem 1.5rem;
    }

    header:has(.nav__toggle[aria-expanded="true"]) {
      nav {
        min-height: 100svh;
        opacity: 1;
        visibility: visible;
      }
    }

    nav {
      background-color: var(--color-background);
      height: 0;
      left: 0;
      padding: 1rem 0;
      position: absolute;
      right: 0;
      top: 101%;
      transition:
        opacity 0.3s,
        transform 0.3s;
      opacity: 0;
      visibility: hidden;
      z-index: 900;
    }

    .nav__item {
      border-bottom: 1px solid rgb(from var(--color-border) r g b / 0.1);

      a {
        align-items: center;
        display: flex;
        gap: 1.5rem;
        padding-block: 1.25rem;
        padding-inline: 1.5rem;
        &:hover {
          position: relative;
          &::before {
            content: "";
            background-color: var(--color-accent);
            height: 100%;
            left: 0;
            opacity: 0.1;
            position: absolute;
            width: 100%;
            z-index: -1;
          }
        }
      }

      &:last-child {
        border-bottom: none;
      }

      .color-circle {
        background-color: var(--color-accent);
        border-radius: var(--corner-radius-full);
        height: 1.25rem;
        width: 1.25rem;
      }

      [data-icon] {
        height: 0.5rem;
        margin-inline-start: auto;
        width: auto;
      }
    }
  }

  @media (min-width: 768px) {
    header {
      align-items: center;
      flex-direction: column;
      gap: clamp(0rem, 4.2857rem + -4.7619vw, 2rem);
      margin-top: clamp(0rem, 4.2857rem + -4.7619vw, 2rem);
    }

    nav,
    .nav__list {
      align-items: stretch;
      display: flex;
      flex-direction: row;
      gap: clamp(2rem, 1.4286rem + 1.1905vw, 2.5rem);
    }

    .nav__item {
      align-items: center;
      border-top: 4px solid transparent;
      display: flex;
      padding-block: 0.5rem 1rem;
      transition: border-color 0.3s;
    }

    .nav__item:hover {
      border-color: var(--color-accent);
    }
  }

  @media (min-width: 1024px) {
    header {
      flex-direction: row;
      margin: 0;
      padding-block: 0;
      padding-inline: 2rem;
    }

    .nav__item {
      padding-block: 1.5rem;
    }
  }

  @media (min-width: 1441px) {
    header {
      margin-inline: auto;
      width: 1440px;
    }
  }
</style>
