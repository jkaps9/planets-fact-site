---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";

const { planet } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/*.{jpeg,jpg,png,gif,webp,svg}",
);
const getImagePath = (jsonPath: string) => {
  const filename = jsonPath.split("/").pop();
  return `/src/assets/images/${filename}`;
};
const geologyImageSrc = images[getImagePath(planet.images.geology)];

if (!geologyImageSrc)
  throw new Error(
    `Could not find planet image at ${getImagePath(planet.images.geology)}`,
  );
---

<section>
  <h1 class="sr-only">{planet.name}</h1>
  <div
    class={`row manual color-${planet.name.toLowerCase()}`}
    role="tablist"
    aria-labelledby="tablist-1"
  >
    <button
      id="tab-1"
      type="button"
      role="tab"
      aria-selected="true"
      aria-controls="tabpanel-1"
    >
      <span class="tab-number">01</span>
      <p>Overview</p>
    </button>
    <button
      id="tab-2"
      type="button"
      role="tab"
      aria-selected="false"
      aria-controls="tabpanel-2"
      tabindex="-1"
    >
      <span class="tab-number">02</span>
      <p>
        <span class="extra-word">Internal</span>
        <span>Structure</span>
      </p>
    </button>
    <button
      id="tab-3"
      type="button"
      role="tab"
      aria-selected="false"
      aria-controls="tabpanel-3"
      tabindex="-1"
    >
      <span class="tab-number">03</span>
      <p>
        <span>Surface</span>
        <span class="extra-word">Geology</span>
      </p>
    </button>
  </div>

  <div
    id="tabpanel-1"
    role="tabpanel"
    aria-labelledby="tab-1"
  >
    <div class="planet__image">
      <Icon
        name={`planet-${planet.name.toLowerCase()}`}
        aria-hidden="true"
      />
    </div>
    <div class="planet__text">
      <p class="planet__name">{planet.name}</p>
      <p class="planet__content">{planet.overview.content}</p>
      <div class="source">
        <span>Source:</span>
        <a href={planet.overview.source}>
          Wikipedia
          <Icon
            name="icon-source"
            aria-hidden="true"
            width={12}
            height={12}
          />
        </a>
      </div>
    </div>
  </div>
  <div
    id="tabpanel-2"
    role="tabpanel"
    aria-labelledby="tab-2"
  >
    <div class="planet__image">
      <Icon
        name={`planet-${planet.name.toLowerCase()}-internal`}
        aria-hidden="true"
      />
    </div>
    <div class="planet__text">
      <p class="planet__name">{planet.name}</p>
      <p class="planet__content">{planet.structure.content}</p>
      <div class="source">
        <span>Source:</span>
        <a href={planet.structure.source}>
          Wikipedia
          <Icon
            name="icon-source"
            aria-hidden="true"
            width={12}
            height={12}
          />
        </a>
      </div>
    </div>
  </div>
  <div
    id="tabpanel-3"
    role="tabpanel"
    aria-labelledby="tab-3"
  >
    <div class="planet__image">
      <div class="geology">
        <Icon
          name={`planet-${planet.name.toLowerCase()}`}
          aria-hidden="true"
        />
        <Image
          src={geologyImageSrc()}
          alt=""
          aria-hidden="true"
          class="planet__geology"
        />
      </div>
    </div>
    <div class="planet__text">
      <p class="planet__name">{planet.name}</p>
      <p class="planet__content">{planet.geology.content}</p>
      <div class="source">
        <span>Source:</span>
        <a href={planet.geology.source}>
          Wikipedia
          <Icon
            name="icon-source"
            aria-hidden="true"
            width={12}
            height={12}
          />
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  /*
   *   This content is licensed according to the W3C Software License at
   *   https://www.w3.org/Consortium/Legal/2015/copyright-software-and-document
   *
   *   File:   tabs-manual.js
   *
   *   Desc:   Tablist widget that implements ARIA Authoring Practices
   */

  "use strict";

  class TabsManual {
    tablistNode: HTMLElement;
    tabs: HTMLElement[];
    tabPanels: HTMLElement[];
    firstTab: HTMLElement | null;
    lastTab: HTMLElement | null;
    constructor(groupNode: HTMLElement) {
      this.tablistNode = groupNode;

      this.tabs = [];

      this.firstTab = null;
      this.lastTab = null;

      this.tabs = Array.from(this.tablistNode.querySelectorAll("[role=tab]"));
      this.tabPanels = [];

      for (var i = 0; i < this.tabs.length; i += 1) {
        var tab = this.tabs[i];
        var tabpanel = document.getElementById(
          tab.getAttribute("aria-controls")!,
        ) as HTMLElement;

        tab.tabIndex = -1;
        tab.setAttribute("aria-selected", "false");
        this.tabPanels.push(tabpanel);

        tab.addEventListener("keydown", this.onKeydown.bind(this));
        tab.addEventListener("click", this.onClick.bind(this));

        if (!this.firstTab) {
          this.firstTab = tab;
        }
        this.lastTab = tab;
      }

      this.setSelectedTab(this.firstTab);
    }

    setSelectedTab(currentTab: HTMLElement | null) {
      for (var i = 0; i < this.tabs.length; i += 1) {
        var tab = this.tabs[i];
        if (currentTab === tab) {
          tab.setAttribute("aria-selected", "true");
          tab.removeAttribute("tabindex");
          this.tabPanels[i].classList.remove("is-hidden");
        } else {
          tab.setAttribute("aria-selected", "false");
          tab.tabIndex = -1;
          this.tabPanels[i].classList.add("is-hidden");
        }
      }
    }

    moveFocusToTab(currentTab: HTMLElement | null) {
      currentTab?.focus();
    }

    moveFocusToPreviousTab(currentTab: HTMLElement | null) {
      var index;

      if (currentTab === this.firstTab) {
        this.moveFocusToTab(this.lastTab);
      } else {
        index = this.tabs.indexOf(currentTab as HTMLElement);
        this.moveFocusToTab(this.tabs[index - 1]);
      }
    }

    moveFocusToNextTab(currentTab: HTMLElement | null) {
      var index;

      if (currentTab === this.lastTab) {
        this.moveFocusToTab(this.firstTab);
      } else {
        index = this.tabs.indexOf(currentTab as HTMLElement);
        this.moveFocusToTab(this.tabs[index + 1]);
      }
    }

    /* EVENT HANDLERS */

    onKeydown(event: KeyboardEvent) {
      var tgt = event.currentTarget as HTMLElement,
        flag = false;

      switch (event.key) {
        case "ArrowLeft":
          this.moveFocusToPreviousTab(tgt);
          flag = true;
          break;

        case "ArrowRight":
          this.moveFocusToNextTab(tgt);
          flag = true;
          break;

        case "Home":
          this.moveFocusToTab(this.firstTab);
          flag = true;
          break;

        case "End":
          this.moveFocusToTab(this.lastTab);
          flag = true;
          break;

        default:
          break;
      }

      if (flag) {
        event.stopPropagation();
        event.preventDefault();
      }
    }

    // Since this example uses buttons for the tabs, the click onr also is activated
    // with the space and enter keys
    onClick(event: MouseEvent) {
      this.setSelectedTab(event.currentTarget as HTMLElement);
    }
  }

  // Initialize tablist

  window.addEventListener("load", function () {
    var tabLists = document.querySelectorAll("[role=tablist].manual");
    for (var i = 0; i < tabLists.length; i++) {
      new TabsManual(tabLists[i] as unknown as HTMLElement);
    }
  });
</script>

<style>
  section {
    display: flex;
    flex-direction: column;
    flex: 1;
    margin-block-end: 1.5rem;
  }

  [role="tablist"] {
    border-bottom: 1px solid rgb(from var(--color-border) r g b / 0.1);
    margin: 1.25rem 0 4rem;
    padding: var(--page-padding);
  }

  [role="tab"] {
    border-bottom: 4px solid transparent;
    color: currentColor;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 2px;
    line-height: 2.75;
    opacity: 0.5;
    text-transform: uppercase;

    &:hover,
    &:focus,
    &[aria-selected="true"] {
      opacity: 1;
      border-color: var(--color-accent);
    }
  }

  [role="tabpanel"] {
    align-items: center;
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: var(--page-padding);
    text-align: center;
    &.is-hidden {
      display: none;
    }
  }

  .planet__image {
    display: grid;
    margin-block-end: auto;
    place-content: center;
    [data-icon] {
      height: clamp(6.9375rem, 2.9982rem + 16.8075vw, 18.125rem);
      width: auto;
    }

    .geology {
      position: relative;

      img {
        height: clamp(6.25rem, 4.0713rem + 9.2958vw, 12.4375rem);
        position: absolute;
        top: 75%;
        left: 50%;
        transform: translate(-50%, 0%);
        width: auto;
      }
    }
  }

  .planet__name {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 1.6197rem + 3.7559vw, 5rem);
    letter-spacing: clamp(0rem, 0.1268rem + -0.1408vw, 0.0938rem);
    line-height: 1.3;
    margin-block-end: 1rem;
    text-transform: uppercase;
  }

  .planet__content {
    font-size: clamp(0.6875rem, 0.6215rem + 0.2817vw, 0.875rem);
    line-height: 1.8;
  }

  .source {
    align-items: center;
    display: flex;
    gap: 0.25rem;
    margin-block-start: 2rem;
    span {
      opacity: 0.5;
    }
    a {
      align-items: center;
      display: flex;
      gap: 0.25rem;
      opacity: 0.5;
      text-decoration: underline;

      &:hover {
        opacity: 1;
      }
    }
  }

  @media (max-width: 767px) {
    .tab-number,
    .extra-word {
      height: 0;
      position: absolute;
      visibility: hidden;
    }
  }

  @media (min-width: 768px) {
    section {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
    }

    [role="tabpanel"] {
      align-items: flex-start;
      flex-direction: row;
      text-align: start;
    }
  }
</style>
